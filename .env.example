AI_PROVIDER=groq
# Set one or more comma-separated keys here. GROQ_API_KEY is supported for a single key.
GROQ_API_KEYS=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Keep account IDs and tokens in matching comma-separated order.
CLOUDFLARE_ACCOUNT_IDS=
CLOUDFLARE_API_TOKENS=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/black-forest-labs/flux-1-schnell
BRAND_NAME=The Daily Chronicle
OUTPUT_DIR=output
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_GRAPH_API_VERSION=
# Optional for generation; required to publish a Reel.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
